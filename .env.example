# Redis Internal
REDIS_URL=redis://default:your_redis_password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Redis Public Endpoint
REDIS_PUBLIC_HOST=your-domain.com:6379

# Qdrant Internal
QDRANT_URL=http://qdrant:6333

# Vector Public Endpoint
VECTOR_PUBLIC_HOST=your-vector-domain.com

# App Env
APP_ENV=development
NODE_ENV=development

# API Key
API_KEY_KASYAF=your_api_key_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_random_32_chars

# SMTP (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

ADMIN_EMAIL=admin@example.com
LOG_LEVEL=info

ENABLE_VECTOR_DB=true
ENABLE_ACL=true
ENABLE_BACKUPS=false