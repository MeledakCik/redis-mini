# Redis Internal
REDIS_URL=redis://default:your_redis_password@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Redis Public Endpoint — WAJIB hostname TERPISAH dari console.kasyaf.id, dan DNS-nya harus
# GREY CLOUD (DNS only / tidak di-proxy Cloudflare) di dashboard Cloudflare. Redis raw TCP
# (port 6379) TIDAK bisa lewat proxy Cloudflare standar (cuma HTTP/HTTPS yang diproxy) —
# kalau hostname ini orange cloud, semua koneksi customer akan ETIMEDOUT/ENETUNREACH ke IP
# edge Cloudflare. Lihat docs/CLOUDFLARE_SETUP.md bagian "Hostname database vs web console".
REDIS_PUBLIC_HOST=db.kasyaf.id:6379

# Qdrant Internal
QDRANT_URL=http://qdrant:6333

# Qdrant Public Endpoint (dipakai buat connection string yang ditampilkan ke customer di UI,
# BEDA dari QDRANT_URL di atas yang internal app -> Qdrant lewat Docker network).
# Sengaja http, BUKAN https - port 6333 gak di-TLS-in langsung oleh nginx, cuma port 443 web
# console yang di-SSL-in. Kalau dipaksa https di sini customer bakal dapet TLS handshake error.
# Sama seperti REDIS_PUBLIC_HOST di atas: WAJIB hostname terpisah & GREY CLOUD, bukan
# console.kasyaf.id (yang harus tetap orange cloud/proxied untuk web console-nya).
QDRANT_HOST=db.kasyaf.id
QDRANT_PUBLIC_URL=http://db.kasyaf.id:6333

# Vector Public Endpoint
VECTOR_PUBLIC_HOST=your-vector-domain.com

# App Env
APP_ENV=development
NODE_ENV=development

# API Key
API_KEY_KASYAF=your_api_key_here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_random_32_chars

# OAuth - Google (buat login console.kasyaf.id)
# Redirect URI: https://console.kasyaf.id/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (buat login console.kasyaf.id)
# Callback URL: https://console.kasyaf.id/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# Whitelist login OAuth - default DENY kalau email gak match salah satu dari:
# ADMIN_EMAIL (di bawah), ALLOWED_EMAILS, atau domain di ALLOWED_DOMAINS
ALLOWED_EMAILS=kasyaf@example.com,admin@kasyaf.id
ALLOWED_DOMAINS=kasyaf.id,meledakcik.com

# SMTP (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

ADMIN_EMAIL=admin@example.com
LOG_LEVEL=info

ENABLE_VECTOR_DB=true
ENABLE_ACL=true
ENABLE_BACKUPS=false

# Pembayaran Manual - tujuan transfer yang ditampilkan di halaman /billing
PAYMENT_BANK_NAME=BCA
PAYMENT_BANK_ACCOUNT_NUMBER=1234567890
PAYMENT_BANK_ACCOUNT_NAME=PT Nama Kamu
PAYMENT_QRIS_IMAGE_URL=/qris.png

# Moota - deteksi mutasi bank/QRIS otomatis (BUKAN payment gateway, cuma baca mutasi
# rekening yang sudah ada). Daftar bank di https://app.moota.co, lalu bikin webhook di
# Dashboard > Integrasi > Webhook, arahkan ke:
# https://console.kasyaf.id/api/billing/webhook/moota
# Isi MOOTA_WEBHOOK_SECRET persis dengan Secret Token yang ditampilkan Moota pas bikin
# webhook itu (dipakai buat verifikasi signature, cek ulang algoritmanya di dashboard).
MOOTA_WEBHOOK_SECRET=

# WhatsApp Business Platform (Cloud API resmi Meta) - notifikasi ke admin tiap Pro
# aktif otomatis. Setup: business.facebook.com -> WhatsApp -> API Setup, lalu bikin
# Message Template kategori UTILITY (mis. "pro_activated") dan tunggu approved.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_ADMIN_NUMBER=62812xxxxxxx
WA_TEMPLATE_NAME=pro_activated
WA_TEMPLATE_LANG=id
