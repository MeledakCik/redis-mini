# .env.example — Mini Upstash Pro
# Copy ke .env.local (dev) atau isi sebagai environment variables (VPS/Railway).

# WAJIB di semua mode. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# auto (default) = deteksi otomatis dari /var/run/docker.sock & RAILWAY_ENVIRONMENT.
# docker    = paksa mode Docker (spawn container Redis/Qdrant lokal — laptop/VPS dengan Docker).
# external  = paksa mode external (Railway atau environment manapun tanpa Docker daemon).
DEPLOYMENT_MODE=auto

# Folder data persisten (instances.json, vector-instances.json, users.json).
# Railway: WAJIB /app/data + mount Volume di path ini, kalau tidak data hilang tiap redeploy.
# VPS/local: bisa dikosongkan (default process.cwd()) atau diarahkan ke folder khusus.
DATA_DIR=/app/data

# WAJIB untuk fitur multi-tenant (lib/tenant.js) — koneksi INTERNAL app ke SATU Redis utama
# tempat SEMUA customer di-host (bukan 1 Redis per customer). App connect ke sini pakai
# default user (full akses "admin"), lalu bikin ACL user terbatas per customer di dalamnya.
#   - local:   redis://localhost:6379
#   - Railway: isi dari "Redis.REDIS_URL" (internal, format redis.railway.internal) di plugin Redis
#   - VPS:     redis://:password@127.0.0.1:6379 (Redis jalan di mesin yang sama dengan app)
# Juga dipakai (opsional) sebagai backend rate-limit & vector-metrics kalau kosong fallback in-memory.
REDIS_URL=

# Host:port yang dikasih ke CUSTOMER buat connect LANGSUNG (redis://user:pass@HOST_INI) —
# BEDA dari REDIS_URL di atas kalau REDIS_URL itu alamat privat/internal (mis. Railway internal
# hostname cuma reachable dari dalam network Railway, gak bisa diakses customer dari luar).
#   - local: localhost:6379
#   - VPS:   <IP-publik-VPS>:6379
#   - Railway: kosongkan ini, isi REDIS_PUBLIC_URL di bawah (Railway kasih "Public Networking"
#     terpisah dari internal URL)
REDIS_PUBLIC_HOST=

# Alternatif REDIS_PUBLIC_HOST — full connection string publik kalau platform-nya nyediain
# (khas Railway: klik "Public Networking" di plugin Redis, copy URL-nya ke sini). Kalau diisi,
# prioritasnya LEBIH TINGGI dari REDIS_PUBLIC_HOST.
REDIS_PUBLIC_URL=

# Qdrant untuk vector database. Wajib diisi kalau DEPLOYMENT_MODE=external.
# Diabaikan kalau DEPLOYMENT_MODE=docker (pakai container lokal 127.0.0.1:6333 otomatis).
QDRANT_URL=http://127.0.0.1:6333

# true = bind port container Redis ke 0.0.0.0 (bisa diakses dari luar host).
# false (default, aman) = bind ke 127.0.0.1 saja. Cuma relevan di mode docker.
ALLOW_EXTERNAL_REDIS=false
