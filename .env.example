# .env.example — Mini Upstash Pro
# Copy ke .env.local (dev) atau isi sebagai environment variables (VPS/Railway).

# WAJIB di semua mode. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# auto (default) = deteksi otomatis dari /var/run/docker.sock & RAILWAY_ENVIRONMENT.
# docker    = paksa mode Docker (spawn container Redis/Qdrant lokal — laptop/VPS dengan Docker).
# external  = paksa mode external (Railway atau environment manapun tanpa Docker daemon).
DEPLOYMENT_MODE=auto

# Folder data persisten (instances.json, vector-instances.json, users.json).
# Railway: WAJIB /app/data + mount Volume di path ini, kalau tidak data hilang tiap redeploy.
# VPS/local: bisa dikosongkan (default process.cwd()) atau diarahkan ke folder khusus.
DATA_DIR=/app/data

# Opsional — Redis internal untuk rate-limit & vector-metrics supaya survive restart/multi-
# instance (khas Railway: tambahkan Redis plugin lalu isi connection string-nya di sini).
# Kalau kosong, fallback otomatis ke in-memory (cukup untuk local/VPS single-instance).
REDIS_URL=

# Qdrant untuk vector database. Wajib diisi kalau DEPLOYMENT_MODE=external.
# Diabaikan kalau DEPLOYMENT_MODE=docker (pakai container lokal 127.0.0.1:6333 otomatis).
QDRANT_URL=http://127.0.0.1:6333

# true = bind port container Redis ke 0.0.0.0 (bisa diakses dari luar host).
# false (default, aman) = bind ke 127.0.0.1 saja. Cuma relevan di mode docker.
ALLOW_EXTERNAL_REDIS=false
