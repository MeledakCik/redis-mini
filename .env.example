# Redis Configuration (internal Docker network)
REDIS_URL=redis://default:CHANGE_ME_32_RANDOM@redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_32_RANDOM

# Redis public endpoint (exposed to clients, NOT internal Docker network)
REDIS_PUBLIC_HOST=console.kasyaf.id:6379

# Qdrant Vector Database (internal Docker network)
QDRANT_URL=http://qdrant:6333

# Vector Database public endpoint (exposed to clients, NOT internal Docker network)
VECTOR_PUBLIC_HOST=vector.kasyaf.id

# Application Environment
APP_ENV=vps
NODE_ENV=production

# API Key for Kasyaf management
API_KEY_KASYAF=CHANGE_ME

# NextAuth Configuration (optional, for auth features)
NEXTAUTH_URL=https://console.kasyaf.id
NEXTAUTH_SECRET=CHANGE_ME_SECURE_RANDOM_SECRET

# Email Configuration (optional, for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=admin@kasyaf.id
SMTP_PASSWORD=CHANGE_ME

# Admin Email
ADMIN_EMAIL=admin@kasyaf.id

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_VECTOR_DB=true
ENABLE_ACL=true
ENABLE_BACKUPS=false
